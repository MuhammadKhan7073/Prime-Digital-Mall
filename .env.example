# Copy to .env.local (local) or set in your host's dashboard. All optional.

# Public site URL — used for canonical links, sitemap, OG, JSON-LD.
# Set to your real domain (or the free *.pages.dev URL) before deploy.
NEXT_PUBLIC_SITE_URL=https://primedigitalmall.com

# ---- Phase 2 backend (optional). Leave blank to run in free static/demo mode. ----
# Get these free at supabase.com → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin panel passcode (client gate for the demo admin at /admin).
# For a real deployment, move admin behind Supabase auth (see BACKEND.md).
NEXT_PUBLIC_ADMIN_CODE=prime-admin
